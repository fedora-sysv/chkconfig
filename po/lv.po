#: ../chkconfig.c:47
#, c-format
msgid "usage:   %s [name]\n"
msgstr "Lietošana: %s [nosaukums]\n"

#: ../chkconfig.c:49
#, c-format
msgid "usage:   %s <enable|disable|is-enabled> [name] \n"
msgstr "Lietošana: %s <enable|disable|is-enabled> [nosaukums] \n"

#: ../chkconfig.c:52
#, c-format
msgid "usage:   %s [--list] [--type <type>] [name]\n"
msgstr "Lietošana: %s [--list] [--type <tips>] [nosaukums]\n"

#: ../chkconfig.c:54
#, c-format
msgid "         %s --add <name>\n"
msgstr "         %s --add <nosaukums>\n"

#: ../chkconfig.c:55
#, c-format
msgid "         %s --del <name>\n"
msgstr "         %s --del <nosaukums>\n"

#: ../chkconfig.c:56
#, c-format
msgid "         %s --override <name>\n"
msgstr "         %s --override <nosaukums>\n"

#: ../chkconfig.c:58
#, c-format
msgid "         %s [--level <levels>] [--type <type>] <name> %s\n"
msgstr "         %s [--level <līmeņi>] [--type <tips>] <nosaukums> %s\n"

#: ../chkconfig.c:66
#, c-format
msgid ""
"\n"
"Note: This output shows SysV services only and does not include native\n"
"      systemd services. SysV configuration data might be overridden by "
"native\n"
"      systemd configuration.\n"
"\n"
msgstr ""
"\n"
"Piezīme: šī izvade rāda tikai SysV pakalpojumus un neietver vietējos\n"
"      systemd pakalpojumus. SysV konfigurācijas datus var aizstāt vietējā\n"
"      systemd konfigurācija.\n"
"\n"

#: ../chkconfig.c:73
#, c-format
msgid ""
"      If you want to list systemd services use 'systemctl list-unit-files'.\n"
"      To see services enabled on particular target use\n"
"      'systemctl list-dependencies [target]'.\n"
"\n"
msgstr ""
"      Lai uzskaitītu systemd pakalpojumus, izmantojiet 'systemctl list-unit-"
"files'.\n"
"      Lai redzētu konkrētam mērķim iespējotos pakalpojumus, izmantojiet\n"
"      'systemctl list-dependencies [mērķis]'.\n"
"\n"

#: ../chkconfig.c:83
#, c-format
msgid ""
"service %s supports chkconfig, but is not referenced in any runlevel (run "
"'chkconfig --add %s')\n"
msgstr ""
"pakalpojums %s atbalsta chkconfig, bet nav norādīts nevienā izpildes līmenī "
"(izpildiet 'chkconfig --add %s')\n"

#: ../chkconfig.c:87
#, c-format
msgid "service %s does not support chkconfig\n"
msgstr "pakalpojums %s neatbalsta chkconfig\n"

#: ../chkconfig.c:89
#, c-format
msgid "error reading information on service %s: %s\n"
msgstr "kļūda, nolasot informāciju par pakalpojumu %s: %s\n"

#: ../chkconfig.c:98
#, c-format
msgid "You do not have enough privileges to perform this operation.\n"
msgstr "Šīs darbības veikšanai nepietiek privilēģiju.\n"

